# Copy this file to .env (local) or add these in Vercel/Netlify env settings
GMAIL_USER=your-email@gmail.com
# 16-character Google App Password (needs 2-Step Verification on)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
FROM_NAME=NeverOrdinary
# Password you type on the page to be allowed to send
ACCESS_KEY=change-me
